<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Barudan embroidery (*.dsb) input</name>
  <id>org.rdcam.laserworks5.input.dsb</id>
  <dependency type="file" location="inx">rdlaser_embroidery.py</dependency>
  <input>
    <extension>.dsb</extension>
    <mimetype>image/x-dsb</mimetype>
    <filetypename>Barudan embroidery (*.dsb)</filetypename>
    <filetypetooltip>Import DSB stitch data as outlines (replaces the LaserWorks CorelDRAW "Import Dst/Dsb Data" button)</filetypetooltip>
  </input>
  <script>
    <command location="inx" interpreter="python">rdlaser_embroidery.py</command>
  </script>
</inkscape-extension>
